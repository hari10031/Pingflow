# Environment variables for the Vercel serverless functions (api/).
# Set these in Vercel → Project → Settings → Environment Variables.
# For local `vercel dev`, copy to .env.local (which is gitignored).

# Fine-grained Personal Access Token with Contents: Read and write on your repo.
GITHUB_TOKEN=

# Your repo coordinates.
GITHUB_OWNER=hari10031
GITHUB_REPO=pingflow
GITHUB_BRANCH=main
SERVICES_PATH=src/data/services.json

# Optional: if set, /api/wake requires ?key=<this value>.
WAKE_SECRET=
